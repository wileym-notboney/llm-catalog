{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "parcel index.html --port 1234 --dist-dir .bundle",
    "lint": "oxlint",
    "bundle": "rm -rf .bundle && parcel build index.html --dist-dir .bundle --no-source-maps && mkdir -p dist && html-inline .bundle/index.html > dist/index.html && rm -rf .bundle"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@parcel/config-default": "^2.16.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.6.1",
    "html-inline": "^1.2.0",
    "oxlint": "^1.81.0",
    "parcel": "^2.16.4",
    "postcss": "^8.5.29",
    "tailwindcss": "3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.2"
  },
  "pnpm": {
    "overrides": {
      "minimist@<0.2.4": "0.2.4",
      "minimist@>=1.0.0 <1.2.6": "1.2.8",
      "postcss-selector-parser@<7.1.6": "7.1.6"
    }
  }
}
